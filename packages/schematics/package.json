{
  "name": "@ahincho/nova-nestjs-schematics",
  "version": "0.16.1",
  "description": "Generators for Nova Platform NestJS services: an upstream client and a feature slice, in the shape the platform expects",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahincho/nova-nestjs-01-platform.git",
    "directory": "packages/schematics"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "schematics": "./dist/collection.json",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "nova build && node scripts/copy-assets.mjs",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "test": "nova test",
    "test:cov": "nova test:cov",
    "typecheck": "nova typecheck"
  },
  "dependencies": {
    "@angular-devkit/core": "^22.1.5",
    "@angular-devkit/schematics": "^22.1.5",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@ahincho/nova-nestjs-toolchain": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "vitest": "^5.0.0"
  },
  "bin": {
    "nova-nestjs-schematics": "./bin/nova-nestjs-schematics.cjs"
  }
}
