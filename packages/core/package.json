{
  "name": "@ahincho/nova-nestjs",
  "version": "0.15.0",
  "description": "The Nova Platform meta-framework for NestJS: response envelope, configuration, HTTP client, request context and health probes, wired by one module and one bootstrap call",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahincho/nova-nestjs-01-platform.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "nova build",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "test": "nova test",
    "test:cov": "nova test:cov",
    "typecheck": "nova typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@ahincho/nova-nestjs-toolchain": "workspace:*",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "vitest": "^5.0.0"
  }
}
