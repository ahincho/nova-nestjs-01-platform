{
  "name": "nova-nestjs",
  "version": "0.0.0",
  "private": true,
  "description": "Nova Platform meta-framework for NestJS",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahincho/nova-nestjs-01-platform.git"
  },
  "type": "commonjs",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "verify": "pnpm peers check && pnpm build && pnpm typecheck && pnpm lint && pnpm test:cov && pnpm format:check",
    "consumer:pack": "node scripts/rewire-consumer.mjs",
    "clean": "pnpm -r run clean",
    "format": "nova format",
    "format:check": "nova format:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "lint": "nova lint"
  },
  "devDependencies": {
    "@ahincho/nova-nestjs-toolchain": "workspace:*",
    "@changesets/cli": "^2.29.7"
  }
}
